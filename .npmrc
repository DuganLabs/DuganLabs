# @basenative/* is published to GitHub Packages under the `basenative` org;
# everything else falls back to npmjs. NODE_AUTH_TOKEN is a PAT with
# read:packages — the deploy workflow's reusable caller already writes it, and
# the `check` job exports it for the same reason.
# Local dev: npm login --scope=@basenative --registry=https://npm.pkg.github.com
@basenative:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
