{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data_mode": {
      "type": "string",
      "enum": ["mock", "live"]
    },
    "notice": {
      "type": "string"
    },
    "confirmation_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "received — the shop confirms through the normal flow",
        "confirmed — booked into the shop’s schedule"
      ]
    },
    "confirmed_slot": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["start", "end", "timezone"],
      "additionalProperties": false
    },
    "sharing_receipt": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "shared_with": {
          "type": "object",
          "properties": {
            "shop_id": {
              "type": "string",
              "minLength": 1
            },
            "business_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["shop_id", "business_name"],
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "name",
              "phone",
              "email",
              "service_address",
              "job_details",
              "photos"
            ]
          }
        },
        "purpose": {
          "type": "string",
          "const": "quote-and-schedule"
        },
        "shared_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["grant_id", "shared_with", "fields", "purpose", "shared_at"],
      "additionalProperties": false
    }
  },
  "required": [
    "data_mode",
    "notice",
    "confirmation_ref",
    "status",
    "sharing_receipt"
  ],
  "additionalProperties": false
}
