{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "enum": [
        "ev-charger-install",
        "panel-upgrade",
        "circuit-outlet",
        "troubleshooting",
        "surge-protection"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "City name or 5-digit ZIP code."
    },
    "params": {
      "description": "Optional pricing-engine inputs (e.g. panel amperage, charger distance). Kept loose until the real engines define their inputs.",
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {}
    }
  },
  "required": ["service", "location"],
  "additionalProperties": false
}
