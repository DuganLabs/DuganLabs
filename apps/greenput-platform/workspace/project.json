{
  "name": "greenput",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "includedScripts": [],
  "projectType": "application",
  "tags": ["scope:root"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run platform:build"
      },
      "configurations": {
        "production": {
          "command": "pnpm exec nx run platform:build:production"
        },
        "development": {
          "command": "pnpm exec nx run platform:build:development"
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run platform:serve"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run platform:test"
      }
    },
    "test:all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec nx run platform:test --watch=false",
          "pnpm exec nx run e2e:e2e"
        ],
        "parallel": false
      }
    }
  }
}
