{
  "name": "pendingbusiness-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/pendingbusiness-app/workspace",
  "tags": ["scope:product", "type:nested-workspace", "access:private"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": "apps/pendingbusiness-app/workspace", "command": "pnpm install --frozen-lockfile" }
    },
    "product-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "cwd": "apps/pendingbusiness-app/workspace",
        "commands": ["pnpm nx run-many --target=lint", "pnpm nx run-many --target=typecheck", "pnpm nx run-many --target=test"],
        "parallel": false
      }
    },
    "product-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": { "cwd": "apps/pendingbusiness-app/workspace", "command": "pnpm nx run site:build" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["install"],
      "options": { "cwd": "apps/pendingbusiness-app/workspace", "command": "pnpm nx run worker:dev" }
    }
  }
}
