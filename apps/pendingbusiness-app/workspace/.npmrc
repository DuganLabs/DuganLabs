# @basenative/* packages are published to GitHub Packages; rest fall back to npmjs.
@basenative:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
auto-install-peers=true
strict-peer-dependencies=false

# CI: NODE_AUTH_TOKEN (PAT with read:packages) is exported and the workflow
# writes the auth header to ~/.npmrc before install. Local dev: use
# `npm login --scope=@basenative --registry=https://npm.pkg.github.com`.
