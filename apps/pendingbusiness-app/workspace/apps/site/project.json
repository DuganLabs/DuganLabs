{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/site/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/build.mjs", "cwd": "apps/site" },
      "outputs": ["{workspaceRoot}/dist/site"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsc --noEmit", "cwd": "apps/site" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec prettier --check .", "cwd": "apps/site" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vitest run", "cwd": "apps/site" }
    }
  }
}
