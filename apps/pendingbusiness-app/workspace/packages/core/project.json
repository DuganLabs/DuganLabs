{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/core/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vitest run", "cwd": "packages/core" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsc --noEmit", "cwd": "packages/core" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec prettier --check .", "cwd": "packages/core" }
    }
  }
}
