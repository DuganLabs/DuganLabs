{
  "name": "pendingbusiness",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/pendingbusiness/src",
  "tags": [
    "scope:site",
    "type:coming-soon"
  ],
  "implicitDependencies": [
    "coming-soon"
  ],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/content.json",
        "{workspaceRoot}/libs/coming-soon/src/content.js"
      ],
      "options": {
        "command": "node tools/scripts/check-content.mjs apps/pendingbusiness/content.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "check"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/pendingbusiness"
      ],
      "options": {
        "command": "node tools/deploy/build-worker.mjs pendingbusiness"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "pnpm exec wrangler dev -c apps/pendingbusiness/wrangler.toml -c apps/leads/wrangler.toml --persist-to .wrangler/state"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "bash tools/deploy/deploy.sh pendingbusiness {args.stage}",
        "args": "--stage=staging"
      }
    }
  }
}
