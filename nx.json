{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/**/*.test.mjs",
      "!{projectRoot}/**/*.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tools/deploy/build-worker.mjs"
    ]
  },
  "targetDefaults": {
    "check": {
      "cache": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build",
        "check"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "deploy": {
      "cache": false
    }
  },
  "parallel": 3,
  "useInferencePlugins": false
}
